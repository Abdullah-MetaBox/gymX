# next-auth's exported types reference @auth/core internals, which pnpm's
# strict symlink layout puts outside the importing package's resolution scope.
# TypeScript then reports TS2742 ("cannot be named without a reference to
# .pnpm/..."). Hoisting these two into the root node_modules makes the types
# nameable again. Standard pnpm workaround, not a dependency on hoisting in
# general — everything else stays strictly isolated.
public-hoist-pattern[]=*next-auth*
public-hoist-pattern[]=*@auth/*

# Keeps peer resolution predictable across the workspace.
strict-peer-dependencies=false
